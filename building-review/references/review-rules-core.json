  "rules": [
    {
      "rule_id": "FIRE-7.1.1-EGRESS-BASIS",
      "status": "active",
      "authority_mode": "normative",
      "specialty": "003建筑工程消防专项",
      "coverage_topic": "fire_egress",
      "review_families": ["设计说明", "平面图"],
      "report_types": ["single"],
      "trigger": {"always": true},
      "required_facts": ["使用功能", "火灾危险性", "耐火等级", "建筑高度或层数", "面积", "人员密度和人员特性"],
      "comparison_method": "核对疏散出口、疏散楼梯和避难设施采用的设计条件是否与项目画像一致。",
      "calculation_required": false,
      "risk_level": "high",
      "basis": {
        "source_role": "B_核心规范",
        "relative_path": "003建筑工程消防专项/B建筑消防核心规范/GB 55037-2022 建筑防火通用规范--带条文说明.pdf",
        "sha256": "f492e3c996a7dfb833e0daa6633d0b151292de3396b13ec4cd99c010b0bb0138",
        "display_name": "《建筑防火通用规范》GB 55037-2022",
        "article": "第7.1.1条",
        "requirement": "建筑疏散出口、疏散楼梯和避难设施应与使用功能、火灾危险性、耐火等级、高度或层数、埋深、面积及人员条件相适应。"
      }
    },
    {
      "rule_id": "FIRE-7.1.2-EXIT-COUNT-WIDTH",
      "status": "active",
      "authority_mode": "normative",
      "specialty": "003建筑工程消防专项",
      "coverage_topic": "fire_egress",
      "review_families": ["平面图"],
      "report_types": ["single"],
      "trigger": {"always": true},
      "required_facts": ["各层和各防火分区疏散人数", "安全出口数量", "出口有效净宽度", "各层疏散楼梯净宽度"],
      "comparison_method": "逐层、逐防火分区计算人数、出口数量和所需总净宽度，并核对上下层楼梯控制值。",
      "calculation_required": true,
      "risk_level": "high",
      "basis": {
        "source_role": "B_核心规范",
        "relative_path": "003建筑工程消防专项/B建筑消防核心规范/GB 55037-2022 建筑防火通用规范--带条文说明.pdf",
        "sha256": "f492e3c996a7dfb833e0daa6633d0b151292de3396b13ec4cd99c010b0bb0138",
        "display_name": "《建筑防火通用规范》GB 55037-2022",
        "article": "第7.1.2条",
        "requirement": "疏散出口应分散布置，房间疏散门应直接通向安全出口；出口宽度和数量应满足安全疏散，各层楼梯净宽度应按相应上下部楼层控制值确定。"
      }
    },
    {
      "rule_id": "FIRE-7.1.3-TRAVEL-DISTANCE",
      "status": "active",
      "authority_mode": "normative",
      "specialty": "003建筑工程消防专项",
      "coverage_topic": "fire_egress",
      "review_families": ["平面图"],
      "report_types": ["single"],
      "trigger": {"always": true},
      "required_facts": ["房间内最远点至疏散门距离", "疏散门至安全出口距离", "走道布置类型", "楼梯间形式"],
      "comparison_method": "按实际可通行路线量取房间内和走道疏散距离，并与适用限值逐点比较。",
      "calculation_required": true,
      "risk_level": "high",
      "basis": {
        "source_role": "B_核心规范",
        "relative_path": "003建筑工程消防专项/B建筑消防核心规范/GB 55037-2022 建筑防火通用规范--带条文说明.pdf",
        "sha256": "f492e3c996a7dfb833e0daa6633d0b151292de3396b13ec4cd99c010b0bb0138",
        "display_name": "《建筑防火通用规范》GB 55037-2022",
        "article": "第7.1.3条",
        "requirement": "最大疏散距离应结合耐火等级、火灾危险性、空间高度、楼梯形式和人员特点确定；房间内任一点至疏散门的距离还应满足条文规定。"
      }
    },
    {
      "rule_id": "FIRE-7.1.4-MINIMUM-WIDTH",
      "status": "active",
      "authority_mode": "normative",
      "specialty": "003建筑工程消防专项",
      "coverage_topic": "fire_egress",
      "review_families": ["平面图", "楼梯大样"],
      "report_types": ["single"],
      "trigger": {"always": true},
      "required_facts": ["疏散出口门净宽", "疏散走道净宽", "疏散楼梯净宽"],
      "comparison_method": "按完成面和门扇开启状态记录有效净宽，逐处与条文最低值及人数计算值比较。",
      "calculation_required": true,
      "risk_level": "high",
      "basis": {
        "source_role": "B_核心规范",
        "relative_path": "003建筑工程消防专项/B建筑消防核心规范/GB 55037-2022 建筑防火通用规范--带条文说明.pdf",
        "sha256": "f492e3c996a7dfb833e0daa6633d0b151292de3396b13ec4cd99c010b0bb0138",
        "display_name": "《建筑防火通用规范》GB 55037-2022",
        "article": "第7.1.4条",
        "requirement": "疏散出口门、室外疏散楼梯、疏散走道和疏散楼梯的净宽度不得小于条文规定的最低值。"
      }
    },
    {
      "rule_id": "FIRE-7.1.5-EGRESS-CLEARANCE",
      "status": "active",
      "authority_mode": "normative",
      "specialty": "003建筑工程消防专项",
      "coverage_topic": "fire_egress",
      "review_families": ["平面图", "剖面图"],
      "report_types": ["single"],
      "trigger": {"always": true},
      "required_facts": ["疏散通道障碍物", "疏散出口和走道净高", "防火分区分隔处疏散门"],
      "comparison_method": "结合平面和剖面核对通道连续性、障碍物、净高及分隔处疏散门。",
      "calculation_required": false,
      "risk_level": "high",
      "basis": {
        "source_role": "B_核心规范",
        "relative_path": "003建筑工程消防专项/B建筑消防核心规范/GB 55037-2022 建筑防火通用规范--带条文说明.pdf",
        "sha256": "f492e3c996a7dfb833e0daa6633d0b151292de3396b13ec4cd99c010b0bb0138",
        "display_name": "《建筑防火通用规范》GB 55037-2022",
        "article": "第7.1.5条",
        "requirement": "疏散通道、走道和出口不得有影响疏散的物体，明显位置应设标志，净高度不得小于2.1m，防火分区分隔处应设疏散门。"
      }
    },
    {
      "rule_id": "FIRE-7.1.6-EGRESS-DOOR-DIRECTION",
      "status": "active",
      "authority_mode": "normative",
      "specialty": "003建筑工程消防专项",
      "coverage_topic": "fire_egress",
      "review_families": ["平面图", "门窗表"],
      "report_types": ["single"],
      "trigger": {"always": true},
      "required_facts": ["疏散门形式", "房间使用人数", "每樘门平均疏散人数", "门开启方向", "楼梯间及前室门方向"],
      "comparison_method": "先核对门窗图例和疏散方向，再按房间人数及部位逐樘判断开启形式和方向。",
      "calculation_required": true,
      "risk_level": "high",
      "basis": {
        "source_role": "B_核心规范",
        "relative_path": "003建筑工程消防专项/B建筑消防核心规范/GB 55037-2022 建筑防火通用规范--带条文说明.pdf",
        "sha256": "f492e3c996a7dfb833e0daa6633d0b151292de3396b13ec4cd99c010b0bb0138",
        "display_name": "《建筑防火通用规范》GB 55037-2022",
        "article": "第7.1.6条",
        "requirement": "除条文允许情形外疏散出口门应为平开门或具备平开功能；规定场所和部位的疏散门应向疏散方向开启。"
      }
    },
    {
      "rule_id": "FIRE-7.1.7-DOOR-WIDTH-IMPACT",
      "status": "active",
      "authority_mode": "normative",
      "specialty": "003建筑工程消防专项",
      "coverage_topic": "safety_coordination",
      "review_families": ["平面图", "楼梯大样", "门窗表"],
      "report_types": ["single"],
      "trigger": {"always": true},
      "required_facts": ["门扇完全开启位置", "楼梯平台有效净宽", "疏散走道有效净宽", "门禁释放方式"],
      "comparison_method": "叠合门扇开启范围与平台、走道有效边界，记录最不利净宽；核对门禁火灾释放。",
      "calculation_required": true,
      "risk_level": "high",
      "basis": {
        "source_role": "B_核心规范",
        "relative_path": "003建筑工程消防专项/B建筑消防核心规范/GB 55037-2022 建筑防火通用规范--带条文说明.pdf",
        "sha256": "f492e3c996a7dfb833e0daa6633d0b151292de3396b13ec4cd99c010b0bb0138",
        "display_name": "《建筑防火通用规范》GB 55037-2022",
        "article": "第7.1.7条",
        "requirement": "疏散出口门应能从两侧手动开启；门完全开启时不得减少楼梯平台或疏散走道有效净宽，门禁应具备火灾自动释放和内部易开启功能。"
      }
    },
    {
      "rule_id": "CIVIL-5.3.2-PUBLIC-STAIR-WIDTH",
      "status": "active",
      "authority_mode": "normative",
      "specialty": "004民用建筑专项",
      "coverage_topic": "stair_geometry",
      "review_families": ["楼梯大样"],
      "report_types": ["single"],
      "trigger": {"all": [{"field": "industrial_building", "values": [false, "否", "false"]}]},
      "required_facts": ["公共楼梯使用特征", "人流股数", "扶手中心线或完成面之间的梯段净宽"],
      "comparison_method": "按每股0.55m和不少于2股人流确定日常公共楼梯净宽，并按扶手中心线或完成面量取。",
      "calculation_required": true,
      "risk_level": "high",
      "basis": {
        "source_role": "B_核心规范",
        "relative_path": "004民用建筑专项/B民用建筑核心规范/GB55031-2022民用建筑通用规范.pdf",
        "sha256": "53e5f7ccfb5641aa3c9dd94ccf7d34174a65e3c030874021ccc22df92cbd0e54",
        "display_name": "《民用建筑通用规范》GB 55031-2022",
        "article": "第5.3.2条",
        "requirement": "供日常交通用的公共楼梯梯段最小净宽应按使用特征、人流股数和每股0.55m确定，并不少于2股人流宽度。"
      }
    },
    {
      "rule_id": "CIVIL-5.3.7-STAIR-HEADROOM",
      "status": "active",
      "authority_mode": "normative",
      "specialty": "004民用建筑专项",
      "coverage_topic": "height_clearance",
      "review_families": ["剖面图", "楼梯大样"],
      "report_types": ["single"],
      "trigger": {"all": [{"field": "industrial_building", "values": [false, "否", "false"]}]},
      "required_facts": ["楼梯平台上部和下部过道净高", "梯段净高"],
      "comparison_method": "在剖面和楼梯大样中量取最不利净高并分别比较。",
      "calculation_required": true,
      "risk_level": "high",
      "basis": {
        "source_role": "B_核心规范",
        "relative_path": "004民用建筑专项/B民用建筑核心规范/GB55031-2022民用建筑通用规范.pdf",
        "sha256": "53e5f7ccfb5641aa3c9dd94ccf7d34174a65e3c030874021ccc22df92cbd0e54",
        "display_name": "《民用建筑通用规范》GB 55031-2022",
        "article": "第5.3.7条",
        "requirement": "公共楼梯平台上下过道净高不应小于2.00m，梯段净高不应小于2.20m。"
      }
    },
    {
      "rule_id": "CIVIL-5.3.8-STAIR-RISER-COUNT",
      "status": "active",
      "authority_mode": "normative",
      "specialty": "004民用建筑专项",
      "coverage_topic": "stair_geometry",
      "review_families": ["楼梯大样"],
      "report_types": ["single"],
