      "comparison_method": "查找实际绿色建筑设计说明，目录无编号或页码不能独立证明说明缺失。",
      "calculation_required": false, "risk_level": "medium",
      "basis": {"relative_path": "020绿色建筑专项/B绿色建筑核心规范/湖南省绿色建筑发展条例（2021年）.docx", "sha256": "a37b11278dc9ff7904ee27237cc52ec4fa06ee45d15112c26e7214e22f3fa417", "source_role": "B_核心规范", "display_name": "《湖南省绿色建筑发展条例》", "article": "第十二条", "requirement": "设计单位应当按照绿色建筑标准和控制性详细规划确定的绿色建筑等级要求进行设计，编制绿色建筑设计说明。"}
    },
    {
      "rule_id": "DEPTH-SPECIALTY-NOTES-COORDINATION", "status": "active", "authority_mode": "design_depth",
      "specialty": "001建筑设计文件编制深度专项", "coverage_topic": "project_applicability",
      "review_families": ["设计说明", "目录索引"], "report_types": ["single", "site"], "trigger": {"always": true},
      "required_facts": ["无障碍专项说明与设施要求的表达及适用事实", "防水专项说明与节点做法的对应及适用事实", "绿色建筑专项说明与目录的对应及适用事实"],
      "comparison_method": "逐专项查正文、专篇和目录；只形成已证明的内部表达缺漏，外部规范要求另用对应B类规则，不以索引困难判设计错误。",
      "calculation_required": false, "risk_level": "medium", "basis": {}
    }
